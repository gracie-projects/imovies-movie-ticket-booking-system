# ------------------------------------------------------------------
# IMovies backend configuration
# Copy this file to backend/.env (or the repository root .env) and edit.
# NEVER commit real values - .env files are ignored by git.
# ------------------------------------------------------------------

# development | production | test
NODE_ENV=development
PORT=5000

# "memory" = temporary in-memory MongoDB (auto-seeded, data lost on restart)
# Local MongoDB:  mongodb://127.0.0.1:27017/imovies
# Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=memory

# Required in production: a long random string (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Comma separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Cookie settings. Use "lax" when frontend and API share a site (default),
# "none" + COOKIE_SECURE=true when they are hosted on different domains over HTTPS.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# Serve the built React app (frontend/dist) from Express - single service deployment
SERVE_FRONTEND=false

# Wipe and reseed demo data every time the server starts (demo environments only!)
SEED_ON_START=false
# Seed demo data only if the database is empty (safe for the first production start)
SEED_IF_EMPTY=false
# Add the standard demo schedule for any of the next 5 days that has no shows
SCHEDULE_AUTOFILL=false
# Time zone used for seeded show times (minutes from UTC, 330 = India)
SEED_UTC_OFFSET_MINUTES=330

# Demo account passwords used by the seed script. Change these for any public deployment.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Number of proxies in front of the app (1 on Render/Railway/Heroku)
# TRUST_PROXY=1
LOG_LEVEL=info
AUTH_RATE_LIMIT=20

# ------------------------------------------------------------------
# Frontend (frontend/.env) - only needed when the API is on another domain
# VITE_API_URL=https://your-api.onrender.com/api
# ------------------------------------------------------------------
